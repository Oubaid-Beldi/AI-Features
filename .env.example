# Copy this file to .env and fill in your key
GEMINI_API_KEY=your_gemini_api_key_here

# Set to "mock" to use fake data, "real" to hit the actual backend at port 8000
BACKEND_MODE=mock

# URL of the main backend (only used when BACKEND_MODE=real)
BACKEND_URL=http://localhost:8000

# Port this microservice listens on
SERVICE_PORT=8001
